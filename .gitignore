# Private planning notes (Claude / ChatGPT guides, CV and interview prep) — never publish
private_notes/

# IDE / OS / local agent tooling
.claude/
.idea/
.vscode/
.DS_Store

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj
renv/library/
renv/staging/
renv/local/
renv/python/

# Quarto
/.quarto/
site/_site/
reports/*_files/

# Excel / LibreOffice lock files
~$*.xlsx
.~lock.*#

# Data: third-party downloads are not committed (fetch per data/raw/README.md; hashes in data/raw/MANIFEST)
data/raw/*
!data/raw/README.md
!data/raw/MANIFEST
data/market/*
!data/market/.gitkeep
data/upper/*
!data/upper/.gitkeep
data/holdout/*
!data/holdout/.gitkeep

# Rendered memo intermediates (the PDF itself is committed)
reports/memo_figures/
reports/*.typ
outputs/*.rds
